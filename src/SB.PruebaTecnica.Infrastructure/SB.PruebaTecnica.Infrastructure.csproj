    <Nullable>enable</Nullable>
    <RootNamespace>SB.PruebaTecnica.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
