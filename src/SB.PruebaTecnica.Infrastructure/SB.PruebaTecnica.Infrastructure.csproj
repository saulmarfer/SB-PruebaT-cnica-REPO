  <ItemGroup>
    <ProjectReference Include="..\SB.PruebaTecnica.Application\SB.PruebaTecnica.Application.csproj" />
  </ItemGroup>

  <ItemGroup> 
    <None Update="Data\entidades-gubernamentales.txt"> 
